# The exact llama_cpp_onicai_fork commit this repo builds against.
#
# llama_cpp_onicai_fork is a SEPARATE repository, cloned into
# src/llama_cpp_onicai_fork/ and gitignored here (.gitignore:2). Until this file
# existed, the workflows checked out `ref: onicai` -- a MOVING BRANCH -- with
# `fetch-depth: 1`, which had two consequences:
#   (1) two CI runs a week apart could build different source, with no commit in
#       this repo to show for it;
#   (2) scripts/build-info-cpp.sh embeds `git rev-list --count HEAD` into the
#       wasm, and a depth-1 clone reports 1 instead of 10078 -- so the CI wasm
#       and a local wasm could never have the same hash.
#
# FORK_COMMIT_SHORT is pinned explicitly rather than derived: `git rev-parse
# --short` picks an abbreviation length from how many objects the clone holds,
# so a shallow clone can abbreviate the same commit differently.
#
# Consumed by:
#   Makefile                        (include + export)
#   docker/docker-compose.yml       (docker compose --env-file ../version_fork.env)
#   .github/workflows/release.yml   (cat >> $GITHUB_ENV)
#   .github/workflows/cicd-mac.yml  (cat >> $GITHUB_ENV, checkout ref)
#
# To bump, as part of a llama.cpp upgrade (see README-contributors-guide.md):
#   git -C src/llama_cpp_onicai_fork fetch origin onicai
#   git -C src/llama_cpp_onicai_fork rev-parse       origin/onicai  -> FORK_COMMIT
#   git -C src/llama_cpp_onicai_fork rev-parse --short origin/onicai -> FORK_COMMIT_SHORT
#   git -C src/llama_cpp_onicai_fork rev-list --count origin/onicai -> FORK_BUILD_NUMBER
# Bumping this changes the wasm hash.
FORK_REPO=onicai/llama_cpp_onicai_fork
FORK_COMMIT=6bd774370579b0c48b8ad3f56df468907d033fe9
FORK_COMMIT_SHORT=6bd774370
FORK_BUILD_NUMBER=10078
